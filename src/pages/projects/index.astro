---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import contributions from '../../data/contributions.json';

const projects = await getCollection('projects');
const ongoingProjects = projects.filter(project => project.data.status === 'ongoing');
const pastProjects = projects.filter(project => project.data.status === 'done');
---

<Layout>
  <p id="projects-intro">
    Here are some of the (public) projects I have worked on.
  </p>
  <h1 id="ongoing-header">
    Ongoing
  </h1>
  <hr />
  <div id="ongoing-projects-container">
    <div id="ongoing-projects-list">
      {ongoingProjects.map(project => (
        <>
          {!project.data.isDraft && <a id="project" href={`/projects/${project.id}`}>
            <h2>{project.data.title}</h2>
            <img src={`${project.data.image.src}`} alt={project.data.image.alt} />
            <p>{project.data.description}</p>
            <div class="project-tags">
              {project.data.tags && project.data.tags.map(tag => (
                <p>{tag}</p>
              ))}
            </div>
          </a>}
        </>
      ))}
    </div>
  </div>
  <h1 id="past-header">
    Past
  </h1>
  <hr />
  <div id="past-projects-container">
    <div id="past-projects-list">
      {pastProjects.map(project => (
        <>
          {!project.data.isDraft && <a id="project" href={`/projects/${project.id}`}>
            <h2>{project.data.title}</h2>
            <img src={`${project.data.image.src}`} alt={project.data.image.alt} />
            <p>{project.data.description}</p>
            <div class="project-tags">
              {project.data.tags && project.data.tags.map(tag => (
                <p>{tag}</p>
              ))}
            </div>
          </a>}
        </>
      ))}
    </div>
  </div>
  <h1 id="contrib-header">
    Contributions
  </h1>
  <hr />
  <div id="contrib-container">
    <div id="contrib-list">
      {contributions.map(contrib => (
        <a class="contrib-card" href={contrib.link}>
          <div class="contrib-title">
            <h2>{contrib.title}</h2>
            <div class="contrib-tags">
              {contrib.tags.map(tag => (
                <p>{tag}</p>
              ))}
            </div>
          </div>
          <p>{contrib.summary}</p>
          <ul>
            {contrib.contributions.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </a>
      ))}
    </div>
  </div>
</Layout>

<style>
  #projects-intro {
    color: #c0caf5;
    text-align: center;
  }

  h1 {
    color: #7aa2f7;
    margin-bottom: 0em;
    margin-top: 1em;
  }

  hr {
    border: 1px solid #7aa2f7;
  }

  div[id$='projects-container'] {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2em;
  }

  div[id$='projects-list'] {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1em;
  }

  @media (min-width: 768px) {
    div[id$='projects-list'] {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    div[id$='projects-list'] {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  #project {
    display: flex;
    flex-direction: column;
    align-items: center;
    border: 1px solid #7aa2f7;
    border-radius: 5px;
    padding-left: 1em;
    padding-right: 1em;
    text-decoration: none;
  }

  #project:hover {
    transform: scale(1.05);
    transition: transform 0.5s;
    background-color: #394b70;
  }

  h2 {
    color: #bb9af7;
  }

  #project img {
    width: 60%;
    height: 60%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    margin-top: -1em;
  }

  p {
    color: #c0caf5;
  }

  #project p {
    text-align: center;
  }

  .project-tags, .contrib-tags {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.3em;
    margin-top: -1em;
  }

  .project-tags p, .contrib-tags p {
    color: #292e42;
    background-color: #7dcfff;
    padding: 5px;
    border-radius: 20px;
    font-size: 0.8em;
    font-weight: bold;
  }

  .contrib-title {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
  }

  .contrib-card {
    display: flex;
    flex-direction: column;
    border-radius: 5px;
    padding-left: 1em;
    padding-right: 1em;
    text-decoration: none;
    padding: 0.5em 0.5em 0.5em 0.5em;
  }

  .contrib-title h2 {
    margin-top: 0em;
    margin-bottom: 0.2em;
  }

  .contrib-card p {
    margin-top: 0.2em;
  }

  .contrib-card:hover {
    background-color: #394b70;
  }

  .contrib-card ul {
    color: #c0caf5;
    list-style-type: disc;
    padding-left: 1.5em;
    margin: 0.1em 0;
    align-self: flex-start;
    list-style-position: inside;
  }
</style>
